# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# These are PUBLIC by design (the anon key is meant to ship to the browser).
# Real security comes from Row-Level Security policies in supabase/schema.sql,
# NOT from hiding this key. Never put the `service_role` key here or anywhere
# in this frontend — that key bypasses RLS.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
