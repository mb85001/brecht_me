---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Dive logs · brecht.me" active="dives">
  <header class="page-head">
    <div>
      <p class="eyebrow">Logbook</p>
      <h1>Dive logs</h1>
    </div>
    <button class="btn btn-primary" id="new-dive">+ New dive</button>
  </header>

  <p class="muted intro">
    The same logbook the DiveScan app syncs to. Only you can see these entries.
  </p>

  <!-- Add / edit form -->
  <form class="card dive-form" id="dive-form" hidden>
    <p class="form-legend" id="form-legend">New dive</p>
    <div class="grid">
      <label>Dive #<input type="number" id="f-number" min="1" /></label>
      <label>Date<input type="date" id="f-date" required /></label>
      <label class="span2">Site name<input type="text" id="f-site" placeholder="e.g. Blue Hole" /></label>
      <label>Max depth (m)<input type="number" id="f-depth" step="0.1" min="0" /></label>
      <label>Bottom time (min)<input type="number" id="f-bottom" min="0" /></label>
      <label>Buddy<input type="text" id="f-buddy" /></label>
      <label>Water temp (°C)<input type="number" id="f-temp" step="0.1" /></label>
      <label class="span2">Notes<textarea id="f-notes" rows="2"></textarea></label>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" id="save-dive">Save dive</button>
      <button type="button" class="btn btn-ghost" id="cancel-dive">Cancel</button>
      <span class="msg" id="dive-msg"></span>
    </div>
  </form>

  <ul id="dives" class="dive-list">
    <li class="muted">Loading…</li>
  </ul>

  <style>
    .page-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.5rem;
    }
    .page-head h1 {
      font-size: var(--step-3);
      margin: 0.3rem 0 0;
    }
    .muted {
      color: var(--text-muted);
    }
    .intro {
      margin: 0 0 1.5rem;
      font-size: var(--step--1);
    }
    .dive-form {
      margin-bottom: 1.5rem;
    }
    .form-legend {
      margin: 0 0 1rem;
      font-weight: 600;
      font-size: var(--step-0);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
    }
    .grid label {
      display: grid;
      gap: 0.35rem;
      font-size: var(--step--1);
      color: var(--text-muted);
    }
    .span2 {
      grid-column: 1 / -1;
    }
    input,
    textarea {
      padding: 0.6rem 0.75rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--surface-border);
      background: var(--bg);
      color: var(--text);
      font: inherit;
    }
    input:focus,
    textarea:focus {
      outline: none;
      border-color: var(--accent);
    }
    .form-actions {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin-top: 1.1rem;
    }
    .msg {
      font-size: var(--step--1);
    }
    .msg.error {
      color: #f87171;
    }
    .dive-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.8rem;
    }
    .dive-item {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      padding: 1rem 1.2rem;
      background: var(--bg-elev);
      border: 1px solid var(--surface-border);
      border-radius: var(--radius);
      transition: border-color 0.2s var(--ease);
    }
    .dive-item:hover {
      border-color: var(--accent);
    }
    .dive-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .dive-photos {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding-bottom: 0.2rem;
    }
    .dive-photos .thumb {
      flex: 0 0 auto;
      display: block;
      line-height: 0;
    }
    .dive-photos .thumb img {
      width: 68px;
      height: 68px;
      object-fit: cover;
      border-radius: var(--radius-sm);
      border: 1px solid var(--surface-border);
      transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
    }
    .dive-photos .thumb:hover img {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .photos-loading {
      font-size: 0.78rem;
    }
    .dive-main {
      display: grid;
      gap: 0.2rem;
    }
    .dive-title {
      font-weight: 600;
    }
    .dive-meta {
      color: var(--text-muted);
      font-size: var(--step--1);
    }
    .dive-depth {
      text-align: right;
      color: var(--accent);
      font-weight: 700;
      white-space: nowrap;
    }
    .dive-actions {
      display: flex;
      align-items: center;
      gap: 0.2rem;
    }
    .icon-btn {
      background: none;
      border: none;
      color: var(--text-faint);
      cursor: pointer;
      font-size: 1rem;
      padding: 0.3rem 0.45rem;
      border-radius: var(--radius-sm);
      line-height: 1;
    }
    .icon-btn.edit:hover {
      color: var(--accent);
      background: var(--accent-soft);
    }
    .icon-btn.del:hover {
      color: #f87171;
    }
    .dive-item.editing {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px var(--accent);
    }
    @media (max-width: 560px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    import { supabase } from '../../lib/supabase';

    const form = document.getElementById('dive-form') as HTMLFormElement;
    const list = document.getElementById('dives')!;
    const msg = document.getElementById('dive-msg')!;
    const legend = document.getElementById('form-legend')!;
    const saveBtn = document.getElementById('save-dive')!;
    const notes = document.getElementById('f-notes') as HTMLTextAreaElement;
    const el = (id: string) => document.getElementById(id) as HTMLInputElement;

    // Fields the form owns, kept in one place so load(), edit and save agree.
    // `photos` is read-only here — the DiveScan app writes it.
    const SELECT =
      'id, dive_number, date, site_name, max_depth_meters, bottom_time_minutes, buddy, water_temp_celsius, notes, photos';

    let dives: any[] = [];
    // null = the form is in "add" mode; a UUID = editing that dive.
    let editingId: string | null = null;

    function openForm(mode: 'new' | 'edit') {
      form.hidden = false;
      legend.textContent = mode === 'edit' ? 'Edit dive' : 'New dive';
      saveBtn.textContent = mode === 'edit' ? 'Update dive' : 'Add dive';
      msg.textContent = '';
      highlightEditing();
    }

    function closeForm() {
      form.reset();
      form.hidden = true;
      editingId = null;
      msg.textContent = '';
      highlightEditing();
    }

    function highlightEditing() {
      list.querySelectorAll('.dive-item').forEach((li) => {
        li.classList.toggle(
          'editing',
          editingId !== null && (li as HTMLElement).dataset.id === editingId
        );
      });
    }

    document.getElementById('new-dive')!.addEventListener('click', () => {
      // The button toggles the add form, but always leaves any edit in progress.
      if (!form.hidden && editingId === null) {
        closeForm();
        return;
      }
      editingId = null;
      form.reset();
      openForm('new');
      el('f-date').focus();
    });

    document.getElementById('cancel-dive')!.addEventListener('click', closeForm);

    function startEdit(d: any) {
      editingId = d.id;
      el('f-number').value = d.dive_number ?? '';
      el('f-date').value = d.date ?? '';
      el('f-site').value = d.site_name ?? '';
      el('f-depth').value = d.max_depth_meters ?? '';
      el('f-bottom').value = d.bottom_time_minutes ?? '';
      el('f-buddy').value = d.buddy ?? '';
      el('f-temp').value = d.water_temp_celsius ?? '';
      notes.value = d.notes ?? '';
      openForm('edit');
      form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function load() {
      const { data, error } = await supabase
        .from('dives')
        .select(SELECT)
        .is('deleted_at', null)
        .order('date', { ascending: false });

      if (error) {
        list.innerHTML = `<li class="muted">Could not load dives: ${escapeHtml(error.message)}</li>`;
        return;
      }
      dives = data ?? [];
      if (dives.length === 0) {
        list.innerHTML =
          '<li class="muted">No dives yet. Click “New dive” to add one.</li>';
        return;
      }
      list.innerHTML = dives
        .map((d: any) => {
          const date = d.date ? new Date(d.date).toLocaleDateString() : '—';
          const bt = d.bottom_time_minutes
            ? ` · ${d.bottom_time_minutes} min`
            : '';
          const buddy = d.buddy ? ` · with ${escapeHtml(d.buddy)}` : '';
          const num = d.dive_number ? `#${d.dive_number} ` : '';
          const photoCount = Array.isArray(d.photos) ? d.photos.length : 0;
          return `<li class="dive-item" data-id="${d.id}">
            <div class="dive-row">
              <div class="dive-main">
                <span class="dive-title">${num}${escapeHtml(d.site_name ?? 'Untitled site')}</span>
                <span class="dive-meta">${date}${bt}${buddy}</span>
              </div>
              <span class="dive-depth">${d.max_depth_meters ? d.max_depth_meters + ' m' : ''}</span>
              <div class="dive-actions">
                <button class="icon-btn edit" data-id="${d.id}" title="Edit" aria-label="Edit dive">✎</button>
                <button class="icon-btn del" data-id="${d.id}" title="Delete" aria-label="Delete dive">✕</button>
              </div>
            </div>
            ${photoCount ? `<div class="dive-photos" data-id="${d.id}"><span class="muted photos-loading">Loading ${photoCount} photo${photoCount > 1 ? 's' : ''}…</span></div>` : ''}
          </li>`;
        })
        .join('');

      list.querySelectorAll('.edit').forEach((b) =>
        b.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id!;
          const dive = dives.find((d) => d.id === id);
          if (dive) startEdit(dive);
        })
      );
      list.querySelectorAll('.del').forEach((b) =>
        b.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id!;
          if (!confirm('Delete this dive?')) return;
          if (id === editingId) closeForm();
          // Soft delete: set a tombstone instead of removing the row, so the
          // DiveScan app picks up the deletion on its next sync.
          await supabase
            .from('dives')
            .update({ deleted_at: new Date().toISOString() })
            .eq('id', id);
          load();
        })
      );
      highlightEditing();
      renderPhotos();
    }

    // The bucket is private, so thumbnails need short-lived signed URLs. Sign
    // every photo path in one batch, then drop the images into each dive row.
    async function renderPhotos() {
      const paths: string[] = [];
      for (const d of dives) {
        for (const p of d.photos ?? []) {
          if (p?.path) paths.push(p.path);
        }
      }
      if (paths.length === 0) return;

      const { data: signed, error } = await supabase.storage
        .from('dive-photos')
        .createSignedUrls(paths, 3600);
      if (error || !signed) return;

      const urlByPath = new Map<string, string>();
      for (const s of signed) {
        if (s.signedUrl && !s.error && s.path) urlByPath.set(s.path, s.signedUrl);
      }

      for (const d of dives) {
        const photos = (d.photos ?? []).filter((p: any) => p?.path && urlByPath.has(p.path));
        const container = list.querySelector(`.dive-photos[data-id="${d.id}"]`) as HTMLElement | null;
        if (!container) continue;
        if (photos.length === 0) {
          container.remove();
          continue;
        }
        container.innerHTML = photos
          .map((p: any) => {
            const url = urlByPath.get(p.path)!;
            const cap = p.caption ? escapeHtml(p.caption) : '';
            return `<a class="thumb" href="${url}" target="_blank" rel="noopener" title="${cap}"><img src="${url}" alt="${cap}" loading="lazy" /></a>`;
          })
          .join('');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.setAttribute('disabled', 'true');
      msg.textContent = 'Saving…';
      msg.className = 'msg';
      const {
        data: { session },
      } = await supabase.auth.getSession();
      if (!session) return;

      const num = (v: string) => (v === '' ? null : Number(v));
      const fields = {
        dive_number: num(el('f-number').value),
        date: el('f-date').value || null,
        site_name: el('f-site').value || null,
        max_depth_meters: num(el('f-depth').value),
        bottom_time_minutes: num(el('f-bottom').value),
        buddy: el('f-buddy').value || null,
        water_temp_celsius: num(el('f-temp').value),
        notes: notes.value || null,
      };

      // Editing bumps updated_at (via the DB trigger), so the app picks the
      // change up on its next sync. New dives get a user_id; updates keep it.
      const { error } = editingId
        ? await supabase.from('dives').update(fields).eq('id', editingId)
        : await supabase.from('dives').insert({ user_id: session.user.id, ...fields });

      saveBtn.removeAttribute('disabled');
      if (error) {
        msg.textContent = error.message;
        msg.className = 'msg error';
        return;
      }
      closeForm();
      load();
    });

    function escapeHtml(s: string) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    load();
  </script>
</AppLayout>
