---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Dive logs · brecht.me" active="dives">
  <header class="page-head">
    <div>
      <p class="eyebrow">Logbook</p>
      <h1>Dive logs</h1>
    </div>
    <button class="btn btn-primary" id="new-dive">+ New dive</button>
  </header>

  <p class="muted intro">
    The same logbook the DiveScan app syncs to. Only you can see these entries.
  </p>

  <!-- Add / edit form -->
  <form class="card dive-form" id="dive-form" hidden>
    <p class="form-legend" id="form-legend">New dive</p>
    <div class="grid">
      <label>Dive #<input type="number" id="f-number" min="1" /></label>
      <label>Date<input type="date" id="f-date" required /></label>
      <label class="span2">Site name<input type="text" id="f-site" placeholder="e.g. Blue Hole" /></label>
      <label>Max depth (m)<input type="number" id="f-depth" step="0.1" min="0" /></label>
      <label>Bottom time (min)<input type="number" id="f-bottom" min="0" /></label>
      <label>Buddy<input type="text" id="f-buddy" /></label>
      <label>Water temp (°C)<input type="number" id="f-temp" step="0.1" /></label>
      <label class="span2">
        Type of dive
        <input type="text" id="f-tags" placeholder="wreck, night, drift" />
      </label>
      <label class="span2">
        Marine life
        <input type="text" id="f-marine" placeholder="turtle, reef shark" />
      </label>
      <label class="span2">Notes<textarea id="f-notes" rows="2"></textarea></label>
    </div>
    <div class="form-photos" id="form-photos" hidden></div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" id="save-dive">Save dive</button>
      <button type="button" class="btn btn-ghost" id="cancel-dive">Cancel</button>
      <span class="msg" id="dive-msg"></span>
    </div>
  </form>

  <!-- Filters. Populated from the loaded dives, so they only ever offer
       values that actually match something. -->
  <div class="filters" id="filters" hidden>
    <select id="f-year" aria-label="Filter by year"><option value="">All years</option></select>
    <select id="f-country" aria-label="Filter by country"><option value="">All countries</option></select>
    <select id="f-buddy" aria-label="Filter by buddy"><option value="">All buddies</option></select>
    <button type="button" class="btn btn-ghost clear" id="clear-filters" hidden>Clear</button>
    <span class="muted count" id="filter-count"></span>
  </div>

  <ul id="dives" class="dive-list">
    <li class="muted">Loading…</li>
  </ul>

  <!-- Read-only detail view; opened by tapping a dive. -->
  <dialog class="detail" id="dive-detail">
    <div class="detail-body" id="detail-body"></div>
    <div class="detail-actions">
      <button class="btn btn-primary" id="detail-edit">Edit dive</button>
      <button class="btn btn-ghost" id="detail-close">Close</button>
      <button class="btn btn-danger" id="detail-delete">Delete</button>
    </div>
  </dialog>

  <style>
    .page-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.5rem;
    }
    .page-head h1 {
      font-size: var(--step-3);
      margin: 0.3rem 0 0;
    }
    .muted {
      color: var(--text-muted);
    }
    .intro {
      margin: 0 0 1.5rem;
      font-size: var(--step--1);
    }
    .dive-form {
      margin-bottom: 1.5rem;
    }
    .form-legend {
      margin: 0 0 1rem;
      font-weight: 600;
      font-size: var(--step-0);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
    }
    .grid label {
      display: grid;
      gap: 0.35rem;
      font-size: var(--step--1);
      color: var(--text-muted);
    }
    .span2 {
      grid-column: 1 / -1;
    }
    input,
    textarea {
      padding: 0.6rem 0.75rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--surface-border);
      background: var(--bg);
      color: var(--text);
      font: inherit;
    }
    input:focus,
    textarea:focus {
      outline: none;
      border-color: var(--accent);
    }
    .form-actions {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin-top: 1.1rem;
    }
    .msg {
      font-size: var(--step--1);
    }
    .msg.error {
      color: #f87171;
    }
    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .filters select {
      padding: 0.45rem 0.6rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--surface-border);
      background: var(--bg-elev);
      color: var(--text);
      font: inherit;
      font-size: var(--step--1);
    }
    .filters select:focus {
      outline: none;
      border-color: var(--accent);
    }
    .filters .clear {
      padding: 0.4rem 0.75rem;
      font-size: var(--step--1);
    }
    .filters .count {
      font-size: var(--step--1);
      margin-left: auto;
    }
    .dive-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.8rem;
    }
    /* ---------------------------------------------------------------------
       Everything below the <ul> is built by JavaScript via innerHTML, so it
       never carries Astro's data-astro-cid attribute and scoped selectors
       would silently miss it. These rules use :global() nested under the
       Astro-rendered .dive-list, which keeps them contained to this list
       while still matching the generated markup.
       --------------------------------------------------------------------- */
    .dive-list :global(.dive-item) {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      cursor: pointer;
      padding: 1rem 1.2rem;
      background: var(--bg-elev);
      border: 1px solid var(--surface-border);
      border-radius: var(--radius);
      transition: border-color 0.2s var(--ease);
    }
    .dive-list :global(.dive-item:hover) {
      border-color: var(--accent);
    }
    .dive-list :global(.dive-row) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .dive-list :global(.dive-photos) {
      display: flex;
      gap: 0.4rem;
      overflow-x: auto;
      padding-bottom: 0.2rem;
    }
    .dive-list :global(.dive-photos .thumb) {
      flex: 0 0 auto;
      display: block;
      line-height: 0;
    }
    .dive-list :global(.dive-photos .thumb img) {
      width: 44px;
      height: 44px;
      object-fit: cover;
      border-radius: var(--radius-sm);
      border: 1px solid var(--surface-border);
      transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
    }
    .dive-list :global(.dive-photos .thumb:hover img) {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .dive-list :global(.photos-loading) {
      font-size: 0.78rem;
    }
    .dive-list :global(.dive-main) {
      display: grid;
      gap: 0.2rem;
      min-width: 0;
    }
    .dive-list :global(.dive-title) {
      font-weight: 600;
    }
    .dive-list :global(.dive-meta) {
      color: var(--text-muted);
      font-size: var(--step--1);
    }
    /* Key dive data, shown as compact chips under the title. */
    .dive-list :global(.dive-facts) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-top: 0.15rem;
    }
    .dive-list :global(.fact) {
      font-size: 0.72rem;
      color: var(--text-muted);
      background: var(--bg-elev-2);
      border: 1px solid var(--surface-border);
      border-radius: 999px;
      padding: 0.12rem 0.5rem;
      white-space: nowrap;
    }
    .dive-list :global(.fact b) {
      color: var(--text);
      font-weight: 600;
    }
    /* Type-of-dive chips read as labels rather than measurements, so they get
       the accent treatment to stand apart from the numeric facts. */
    .dive-list :global(.fact.type) {
      color: var(--accent);
      background: var(--accent-soft);
      border-color: transparent;
      font-weight: 600;
    }
    .dive-list :global(.dive-depth) {
      text-align: right;
      color: var(--accent);
      font-weight: 700;
      white-space: nowrap;
    }
    .dive-list :global(.dive-actions) {
      display: flex;
      align-items: center;
      gap: 0.2rem;
    }
    .dive-list :global(.icon-btn) {
      background: none;
      border: none;
      color: var(--text-faint);
      cursor: pointer;
      font-size: 1rem;
      padding: 0.3rem 0.45rem;
      border-radius: var(--radius-sm);
      line-height: 1;
    }
    .dive-list :global(.icon-btn.edit:hover) {
      color: var(--accent);
      background: var(--accent-soft);
    }
    .dive-list :global(.icon-btn.del:hover) {
      color: #f87171;
    }
    .dive-list :global(.dive-item.editing) {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px var(--accent);
    }
    /* While editing, the dive being edited owns the photo display: its
       thumbnails move into the form, and the other dives' strips are hidden so
       it's unambiguous which photos belong to what you're editing. */
    .dive-list.editing-mode :global(.dive-photos) {
      display: none;
    }
    .form-photos {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      margin-top: 1rem;
      align-items: center;
    }
    /* ---------------------------------------------------------------------
       Detail view
       --------------------------------------------------------------------- */
    .detail {
      width: min(100% - 2rem, 34rem);
      max-height: 85vh;
      padding: 0;
      border: 1px solid var(--surface-border);
      border-radius: var(--radius);
      background: var(--bg-elev);
      color: var(--text);
      overflow: hidden;
    }
    .detail::backdrop {
      background: rgba(3, 10, 18, 0.6);
      backdrop-filter: blur(3px);
    }
    .detail-body {
      padding: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
      overflow-y: auto;
      max-height: calc(85vh - 4.5rem);
    }
    .detail-actions {
      display: flex;
      gap: 0.6rem;
      padding: 0.8rem clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
      border-top: 1px solid var(--surface-border);
      background: var(--bg-elev-2);
    }
    .btn-danger {
      margin-left: auto;
      border: 1px solid var(--surface-border);
      background: transparent;
      color: #f87171;
    }
    .btn-danger:hover {
      border-color: #f87171;
    }
    /* Detail content is JS-generated — see the note above the .dive-list rules. */
    .detail-body :global(.detail-title) {
      font-size: var(--step-2);
      font-weight: 650;
      margin: 0 0 0.2rem;
      letter-spacing: -0.02em;
    }
    .detail-body :global(.detail-sub) {
      color: var(--text-muted);
      font-size: var(--step--1);
      margin: 0 0 1.2rem;
    }
    .detail-body :global(.detail-grid) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
      gap: 0.7rem 1rem;
      margin-bottom: 1.2rem;
    }
    .detail-body :global(.detail-cell) {
      display: grid;
      gap: 0.1rem;
      min-width: 0;
    }
    .detail-body :global(.detail-label) {
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-faint);
    }
    .detail-body :global(.detail-value) {
      font-weight: 600;
      overflow-wrap: anywhere;
    }
    .detail-body :global(.detail-section) {
      margin-bottom: 1.2rem;
    }
    .detail-body :global(.detail-section h3) {
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-faint);
      margin: 0 0 0.4rem;
      font-weight: 600;
    }
    .detail-body :global(.detail-chips) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .detail-body :global(.detail-chips .fact) {
      font-size: 0.78rem;
      color: var(--accent);
      background: var(--accent-soft);
      border: 1px solid transparent;
      border-radius: 999px;
      padding: 0.15rem 0.6rem;
      font-weight: 600;
    }
    .detail-body :global(.detail-notes) {
      color: var(--text-muted);
      white-space: pre-wrap;
      margin: 0;
    }
    .detail-body :global(.detail-photos) {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .detail-body :global(.detail-photos img) {
      width: 92px;
      height: 92px;
      object-fit: cover;
      border-radius: var(--radius-sm);
      border: 1px solid var(--surface-border);
    }

    /* Also JS-generated — see the note above the .dive-list rules. */
    .form-photos :global(img) {
      width: 44px;
      height: 44px;
      object-fit: cover;
      border-radius: var(--radius-sm);
      border: 1px solid var(--surface-border);
      flex: 0 0 auto;
    }
    .form-photos :global(.hint) {
      color: var(--text-faint);
      font-size: 0.78rem;
    }
    @media (max-width: 560px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    import { supabase } from '../../lib/supabase';

    const form = document.getElementById('dive-form') as HTMLFormElement;
    const list = document.getElementById('dives')!;
    const msg = document.getElementById('dive-msg')!;
    const legend = document.getElementById('form-legend')!;
    const saveBtn = document.getElementById('save-dive')!;
    const notes = document.getElementById('f-notes') as HTMLTextAreaElement;
    const formPhotos = document.getElementById('form-photos') as HTMLElement;
    const detail = document.getElementById('dive-detail') as HTMLDialogElement;
    const detailBody = document.getElementById('detail-body') as HTMLElement;
    /// The dive currently shown in the detail dialog.
    let detailDiveId: string | null = null;
    const el = (id: string) => document.getElementById(id) as HTMLInputElement;
    // Declared after `el` on purpose: these call it, and a `const` used before
    // its declaration throws at load, which left the list stuck on "Loading…".
    const filtersBar = document.getElementById('filters') as HTMLElement;
    const yearFilter = document.getElementById('f-year') as HTMLSelectElement;
    const countryFilter = document.getElementById('f-country') as HTMLSelectElement;
    const buddyFilter = document.getElementById('f-buddy') as HTMLSelectElement;
    const clearFilters = document.getElementById('clear-filters') as HTMLButtonElement;
    const filterCount = document.getElementById('filter-count') as HTMLElement;
    const tagsField = el('f-tags');
    const marineField = el('f-marine');

    // Fields the form owns, kept in one place so load(), edit and save agree.
    // `photos` is read-only here — the DiveScan app writes it.
    const SELECT =
      'id, dive_number, date, site_name, location_detail, max_depth_meters, ' +
      'bottom_time_minutes, buddy, water_temp_celsius, visibility_meters, ' +
      'oxygen_percent, start_pressure_bar, end_pressure_bar, tank_size_liters, ' +
      'water_type, exposure_suit, weights_kg, conditions, notes, photos, tags, marine_life';

    let dives: any[] = [];
    // null = the form is in "add" mode; a UUID = editing that dive.
    let editingId: string | null = null;
    /// Signed thumbnail URLs by storage path, shared between the dive list and
    /// the edit form so the form doesn't have to re-sign them.
    const signedUrlByPath = new Map<string, string>();

    function openForm(mode: 'new' | 'edit') {
      form.hidden = false;
      legend.textContent = mode === 'edit' ? 'Edit dive' : 'New dive';
      saveBtn.textContent = mode === 'edit' ? 'Update dive' : 'Add dive';
      msg.textContent = '';
      highlightEditing();
    }

    function closeForm() {
      form.reset();
      form.hidden = true;
      editingId = null;
      msg.textContent = '';
      highlightEditing();
    }

    function highlightEditing() {
      list.querySelectorAll('.dive-item').forEach((li) => {
        li.classList.toggle(
          'editing',
          editingId !== null && (li as HTMLElement).dataset.id === editingId
        );
      });
      // Hide every dive's photo strip while editing; the edited dive's photos
      // are shown in the form instead, so there's no ambiguity about which
      // thumbnails belong to what's being edited.
      list.classList.toggle('editing-mode', editingId !== null);
      renderFormPhotos();
    }

    /// Shows the photos of the dive currently being edited, inside the form.
    function renderFormPhotos() {
      const dive = dives.find((d) => d.id === editingId);
      const photos = (dive?.photos ?? []).filter(
        (p: any) => p?.path && signedUrlByPath.has(p.path)
      );
      if (!dive || photos.length === 0) {
        formPhotos.hidden = true;
        formPhotos.innerHTML = '';
        return;
      }
      formPhotos.hidden = false;
      formPhotos.innerHTML =
        photos
          .map((p: any) => {
            const url = signedUrlByPath.get(p.path)!;
            const cap = p.caption ? escapeHtml(p.caption) : '';
            return `<img src="${url}" alt="${cap}" title="${cap}" loading="lazy" />`;
          })
          .join('') +
        '<span class="hint">Photos are managed in the DiveScan app.</span>';
    }

    document.getElementById('new-dive')!.addEventListener('click', () => {
      // The button toggles the add form, but always leaves any edit in progress.
      if (!form.hidden && editingId === null) {
        closeForm();
        return;
      }
      editingId = null;
      form.reset();
      openForm('new');
      el('f-date').focus();
    });

    document.getElementById('cancel-dive')!.addEventListener('click', closeForm);

    for (const select of [yearFilter, countryFilter, buddyFilter]) {
      select.addEventListener('change', renderList);
    }
    clearFilters.addEventListener('click', () => {
      yearFilter.value = '';
      countryFilter.value = '';
      buddyFilter.value = '';
      renderList();
    });

    // ---- detail dialog actions ----
    document.getElementById('detail-close')!.addEventListener('click', () => detail.close());
    document.getElementById('detail-edit')!.addEventListener('click', () => {
      const dive = dives.find((d) => d.id === detailDiveId);
      detail.close();
      if (dive) startEdit(dive);
    });
    document.getElementById('detail-delete')!.addEventListener('click', async () => {
      const id = detailDiveId;
      if (!id || !confirm('Delete this dive?')) return;
      detail.close();
      if (id === editingId) closeForm();
      await supabase
        .from('dives')
        .update({ deleted_at: new Date().toISOString() })
        .eq('id', id);
      load();
    });
    // Clicking the backdrop closes the dialog.
    detail.addEventListener('click', (e) => {
      if (e.target === detail) detail.close();
    });

    function startEdit(d: any) {
      editingId = d.id;
      el('f-number').value = d.dive_number ?? '';
      el('f-date').value = d.date ?? '';
      el('f-site').value = d.site_name ?? '';
      el('f-depth').value = d.max_depth_meters ?? '';
      el('f-bottom').value = d.bottom_time_minutes ?? '';
      el('f-buddy').value = d.buddy ?? '';
      el('f-temp').value = d.water_temp_celsius ?? '';
      notes.value = d.notes ?? '';
      tagsField.value = (d.tags ?? []).join(', ');
      marineField.value = (d.marine_life ?? []).join(', ');
      openForm('edit');
      form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function load() {
      const { data, error } = await supabase
        .from('dives')
        .select(SELECT)
        .is('deleted_at', null)
        .order('date', { ascending: false });

      if (error) {
        // A missing column means the database schema is behind the app —
        // say so plainly instead of just showing an empty list.
        const schemaIssue = /column .* does not exist/i.test(error.message);
        list.innerHTML = `<li class="muted">Could not load dives: ${escapeHtml(error.message)}${
          schemaIssue
            ? '<br />Run <code>supabase/schema.sql</code> in the Supabase SQL editor to add the missing columns.'
            : ''
        }</li>`;
        return;
      }
      dives = data ?? [];
      if (dives.length === 0) {
        filtersBar.hidden = true;
        list.innerHTML =
          '<li class="muted">No dives yet. Click “New dive” to add one.</li>';
        return;
      }
      populateFilters();
      renderList();
    }

    /// Fills each filter with the values actually present in the logbook, so a
    /// selection can never produce an empty list.
    function populateFilters() {
      const years = distinct(
        dives.map((d: any) => (d.date ? String(new Date(d.date).getFullYear()) : ''))
      ).sort((a, b) => Number(b) - Number(a));
      const countries = distinct(dives.map((d: any) => countryOf(d))).sort();
      const buddies = distinct(dives.map((d: any) => d.buddy ?? '')).sort();

      fillSelect(yearFilter, years, 'All years');
      fillSelect(countryFilter, countries, 'All countries');
      fillSelect(buddyFilter, buddies, 'All buddies');
      filtersBar.hidden = false;
    }

    function fillSelect(select: HTMLSelectElement, values: string[], allLabel: string) {
      const previous = select.value;
      select.innerHTML =
        `<option value="">${allLabel}</option>` +
        values.map((v) => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');
      // Keep the current choice if it still exists after a reload.
      if (values.includes(previous)) select.value = previous;
      // A filter with nothing to choose between is just noise.
      select.hidden = values.length === 0;
    }

    /// Country is the last part of the location text ("Dahab, South Sinai,
    /// Egypt"), matching how the app derives it — reverse geocoding writes
    /// locality, area, country.
    function countryOf(d: any): string {
      const parts = String(d.location_detail ?? '')
        .split(',')
        .map((v) => v.trim())
        .filter(Boolean);
      return parts.length ? parts[parts.length - 1] : '';
    }

    /// Non-empty, trimmed, deduplicated case-insensitively.
    function distinct(values: string[]): string[] {
      const seen = new Set<string>();
      const out: string[] = [];
      for (const raw of values) {
        const value = (raw ?? '').trim();
        if (!value || seen.has(value.toLowerCase())) continue;
        seen.add(value.toLowerCase());
        out.push(value);
      }
      return out;
    }

    function visibleDives(): any[] {
      const year = yearFilter.value;
      const country = countryFilter.value.toLowerCase();
      const buddy = buddyFilter.value.toLowerCase();
      return dives.filter((d: any) => {
        if (year && (!d.date || String(new Date(d.date).getFullYear()) !== year)) return false;
        if (country && countryOf(d).toLowerCase() !== country) return false;
        if (buddy && (d.buddy ?? '').trim().toLowerCase() !== buddy) return false;
        return true;
      });
    }

    /// Renders the list for the current filters. Dives arrive already sorted
    /// by date descending from the query.
    function renderList() {
      const shown = visibleDives();
      const filtering = Boolean(yearFilter.value || countryFilter.value || buddyFilter.value);
      clearFilters.hidden = !filtering;
      filterCount.textContent = filtering
        ? `${shown.length} of ${dives.length} dives`
        : `${dives.length} dive${dives.length === 1 ? '' : 's'}`;

      if (shown.length === 0) {
        list.innerHTML = '<li class="muted">No dives match these filters.</li>';
        return;
      }
      list.innerHTML = shown
        .map((d: any) => {
          const date = d.date ? new Date(d.date).toLocaleDateString() : '—';
          const bt = d.bottom_time_minutes
            ? ` · ${d.bottom_time_minutes} min`
            : '';
          const buddy = d.buddy ? ` · with ${escapeHtml(d.buddy)}` : '';
          const num = d.dive_number ? `#${d.dive_number} ` : '';
          const photoCount = Array.isArray(d.photos) ? d.photos.length : 0;
          const where = d.location_detail
            ? ` · ${escapeHtml(d.location_detail)}`
            : '';
          return `<li class="dive-item" data-id="${d.id}">
            <div class="dive-row">
              <div class="dive-main">
                <span class="dive-title">${num}${escapeHtml(d.site_name ?? 'Untitled site')}</span>
                <span class="dive-meta">${date}${bt}${buddy}${where}</span>
                ${facts(d)}
              </div>
              <span class="dive-depth">${d.max_depth_meters ? d.max_depth_meters + ' m' : ''}</span>
              <div class="dive-actions">
                <button class="icon-btn open" data-id="${d.id}" title="Details" aria-label="Show dive details">›</button>
                <button class="icon-btn edit" data-id="${d.id}" title="Edit" aria-label="Edit dive">✎</button>
                <button class="icon-btn del" data-id="${d.id}" title="Delete" aria-label="Delete dive">✕</button>
              </div>
            </div>
            ${photoCount ? `<div class="dive-photos" data-id="${d.id}"><span class="muted photos-loading">Loading ${photoCount} photo${photoCount > 1 ? 's' : ''}…</span></div>` : ''}
          </li>`;
        })
        .join('');

      // Tapping the row opens the read-only detail; the action buttons stop
      // propagation so they don't also trigger it.
      list.querySelectorAll('.dive-item').forEach((li) =>
        li.addEventListener('click', () => {
          const id = (li as HTMLElement).dataset.id!;
          const dive = dives.find((d) => d.id === id);
          if (dive) showDetail(dive);
        })
      );
      list.querySelectorAll('.open').forEach((b) =>
        b.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = (e.currentTarget as HTMLElement).dataset.id!;
          const dive = dives.find((d) => d.id === id);
          if (dive) showDetail(dive);
        })
      );
      list.querySelectorAll('.edit').forEach((b) =>
        b.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = (e.currentTarget as HTMLElement).dataset.id!;
          const dive = dives.find((d) => d.id === id);
          if (dive) startEdit(dive);
        })
      );
      list.querySelectorAll('.del').forEach((b) =>
        b.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = (e.currentTarget as HTMLElement).dataset.id!;
          if (!confirm('Delete this dive?')) return;
          if (id === editingId) closeForm();
          // Soft delete: set a tombstone instead of removing the row, so the
          // DiveScan app picks up the deletion on its next sync.
          await supabase
            .from('dives')
            .update({ deleted_at: new Date().toISOString() })
            .eq('id', id);
          load();
        })
      );
      highlightEditing();
      renderPhotos();
    }

    // The bucket is private, so thumbnails need short-lived signed URLs. Sign
    // every photo path in one batch, then drop the images into each dive row.
    async function renderPhotos() {
      signedUrlByPath.clear();
      const paths: string[] = [];
      for (const d of dives) {
        for (const p of d.photos ?? []) {
          if (p?.path) paths.push(p.path);
        }
      }
      if (paths.length === 0) {
        renderFormPhotos();
        return;
      }

      const { data: signed, error } = await supabase.storage
        .from('dive-photos')
        .createSignedUrls(paths, 3600);
      if (error || !signed) return;

      const urlByPath = signedUrlByPath;
      for (const s of signed) {
        if (s.signedUrl && !s.error && s.path) urlByPath.set(s.path, s.signedUrl);
      }

      for (const d of dives) {
        const photos = (d.photos ?? []).filter((p: any) => p?.path && urlByPath.has(p.path));
        const container = list.querySelector(`.dive-photos[data-id="${d.id}"]`) as HTMLElement | null;
        if (!container) continue;
        if (photos.length === 0) {
          container.remove();
          continue;
        }
        container.innerHTML = photos
          .map((p: any) => {
            const url = urlByPath.get(p.path)!;
            const cap = p.caption ? escapeHtml(p.caption) : '';
            return `<a class="thumb" href="${url}" target="_blank" rel="noopener" title="${cap}"><img src="${url}" alt="${cap}" loading="lazy" /></a>`;
          })
          .join('');
      }
      // The form's strip needs the URLs too, and they only exist now.
      renderFormPhotos();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.setAttribute('disabled', 'true');
      msg.textContent = 'Saving…';
      msg.className = 'msg';
      const {
        data: { session },
      } = await supabase.auth.getSession();
      if (!session) return;

      const num = (v: string) => (v === '' ? null : Number(v));
      const fields = {
        dive_number: num(el('f-number').value),
        date: el('f-date').value || null,
        site_name: el('f-site').value || null,
        max_depth_meters: num(el('f-depth').value),
        bottom_time_minutes: num(el('f-bottom').value),
        buddy: el('f-buddy').value || null,
        water_temp_celsius: num(el('f-temp').value),
        notes: notes.value || null,
        tags: splitList(tagsField.value),
        marine_life: splitList(marineField.value),
      };

      // Editing bumps updated_at (via the DB trigger), so the app picks the
      // change up on its next sync. New dives get a user_id; updates keep it.
      const { error } = editingId
        ? await supabase.from('dives').update(fields).eq('id', editingId)
        : await supabase.from('dives').insert({ user_id: session.user.id, ...fields });

      saveBtn.removeAttribute('disabled');
      if (error) {
        msg.textContent = error.message;
        msg.className = 'msg error';
        return;
      }
      closeForm();
      load();
    });

    /// Comma-separated text to a clean string array (the app stores these as
    /// arrays; the form edits them as one line).
    function splitList(value: string): string[] {
      return value
        .split(',')
        .map((v) => v.trim())
        .filter((v) => v.length > 0);
    }

    function escapeHtml(s: string) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    /// Read-only detail view for one dive, with Edit / Delete actions.
    function showDetail(d: any) {
      detailDiveId = d.id;
      const num = d.dive_number ? `#${d.dive_number} · ` : '';
      const date = d.date
        ? new Date(d.date).toLocaleDateString(undefined, {
            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
          })
        : 'No date';

      const cells: string[] = [];
      const cell = (label: string, value: string | null) => {
        if (value == null || value === '') return;
        cells.push(
          `<div class="detail-cell"><span class="detail-label">${label}</span>` +
            `<span class="detail-value">${escapeHtml(value)}</span></div>`
        );
      };

      cell('Max depth', d.max_depth_meters != null ? `${d.max_depth_meters} m` : null);
      cell('Bottom time', d.bottom_time_minutes != null ? `${d.bottom_time_minutes} min` : null);
      cell('Buddy', d.buddy);
      cell('Water temp', d.water_temp_celsius != null ? `${d.water_temp_celsius} °C` : null);
      cell('Visibility', d.visibility_meters != null ? `${d.visibility_meters} m` : null);
      cell('Gas', d.oxygen_percent != null
        ? (d.oxygen_percent === 21 ? 'Air' : `EAN${d.oxygen_percent}`) : null);
      cell('Tank pressure', d.start_pressure_bar != null && d.end_pressure_bar != null
        ? `${d.start_pressure_bar} → ${d.end_pressure_bar} bar` : null);
      cell('Tank size', d.tank_size_liters != null ? `${d.tank_size_liters} L` : null);
      cell('Weights', d.weights_kg != null ? `${d.weights_kg} kg` : null);
      cell('Water type', d.water_type);
      cell('Exposure suit', d.exposure_suit);
      cell('Conditions', d.conditions);

      const sac = surfaceAirConsumption(d);
      if (sac) cell('SAC', `${sac} bar/min`);
      const mod = maxOperatingDepth(d);
      if (mod) cell('Max operating depth', `${mod} m`);

      const photos = (d.photos ?? []).filter(
        (p: any) => p?.path && signedUrlByPath.has(p.path)
      );

      detailBody.innerHTML =
        `<p class="detail-title">${num}${escapeHtml(d.site_name ?? 'Untitled site')}</p>` +
        `<p class="detail-sub">${escapeHtml(date)}${
          d.location_detail ? ` · ${escapeHtml(d.location_detail)}` : ''
        }</p>` +
        (cells.length ? `<div class="detail-grid">${cells.join('')}</div>` : '') +
        listSection('Type of dive', d.tags) +
        listSection('Marine life', d.marine_life) +
        (d.notes
          ? `<div class="detail-section"><h3>Notes</h3><p class="detail-notes">${escapeHtml(d.notes)}</p></div>`
          : '') +
        (photos.length
          ? `<div class="detail-section"><h3>Photos</h3><div class="detail-photos">${photos
              .map((p: any) => {
                const cap = p.caption ? escapeHtml(p.caption) : '';
                return `<img src="${signedUrlByPath.get(p.path)}" alt="${cap}" title="${cap}" loading="lazy" />`;
              })
              .join('')}</div></div>`
          : '');

      detail.showModal();
    }

    /// A detail section rendering a string array as chips, omitted when empty.
    function listSection(title: string, values: string[] | null | undefined): string {
      if (!values || values.length === 0) return '';
      const chips = values
        .map((v) => `<span class="fact type">${escapeHtml(v)}</span>`)
        .join('');
      return `<div class="detail-section"><h3>${escapeHtml(title)}</h3><div class="detail-chips">${chips}</div></div>`;
    }

    /// Nitrox MOD at a 1.4 ppO2 limit; null for air or missing data. Mirrors
    /// DiveAnalysis in the app.
    function maxOperatingDepth(d: any): string | null {
      const o2 = d.oxygen_percent;
      if (o2 == null || o2 <= 21) return null;
      return ((1.4 / (o2 / 100) - 1) * 10).toFixed(1);
    }

    /// Compact chips of a dive's key data. Only fields that were actually
    /// recorded appear, so a sparsely-filled dive doesn't render empty chips.
    function facts(d: any): string {
      const chips: string[] = [];
      const add = (label: string, value: string) =>
        chips.push(`<span class="fact">${label} <b>${escapeHtml(value)}</b></span>`);

      for (const tag of d.tags ?? []) {
        chips.push(`<span class="fact type">${escapeHtml(tag)}</span>`);
      }
      if (d.water_temp_celsius != null) add('Water', `${d.water_temp_celsius} °C`);
      if (d.visibility_meters != null) add('Vis', `${d.visibility_meters} m`);
      if (d.oxygen_percent != null) {
        add('Gas', d.oxygen_percent === 21 ? 'Air' : `EAN${d.oxygen_percent}`);
      }
      if (d.start_pressure_bar != null && d.end_pressure_bar != null) {
        add('Tank', `${d.start_pressure_bar}→${d.end_pressure_bar} bar`);
      }
      if (d.tank_size_liters != null) add('Size', `${d.tank_size_liters} L`);
      if (d.weights_kg != null) add('Weights', `${d.weights_kg} kg`);
      if (d.water_type) add('Water type', d.water_type);
      if (d.exposure_suit) add('Suit', d.exposure_suit);
      if (d.conditions) add('Conditions', d.conditions);

      // Surface Air Consumption, when there's enough data — the number divers
      // actually compare between dives. Mirrors DiveAnalysis in the app.
      const sac = surfaceAirConsumption(d);
      if (sac) add('SAC', `${sac} bar/min`);

      return chips.length ? `<span class="dive-facts">${chips.join('')}</span>` : '';
    }

    function surfaceAirConsumption(d: any): string | null {
      const { start_pressure_bar: s, end_pressure_bar: e } = d;
      const t = d.bottom_time_minutes;
      const depth = d.max_depth_meters;
      if (s == null || e == null || t == null || depth == null) return null;
      if (s <= e || t <= 0 || depth < 0) return null;
      const ata = depth / 10 + 1;
      return ((s - e) / t / ata).toFixed(2);
    }

    load();
  </script>
</AppLayout>
